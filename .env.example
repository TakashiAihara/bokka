# ===========================================
# Bokka Environment Variables
# ===========================================

# Database (TiDB Serverless compatible MySQL)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=bokka
DATABASE_USER=root
DATABASE_PASSWORD=

# Valkey (Redis compatible)
VALKEY_HOST=localhost
VALKEY_PORT=6379

# Apache Pulsar
PULSAR_SERVICE_URL=pulsar://localhost:6650
PULSAR_ADMIN_URL=http://localhost:8080

# ===========================================
# Service Ports
# ===========================================

# Core Services - HTTP
BOOKMARKS_ORGANIZER_READ_HTTP_PORT=3001
BOOKMARKS_ORGANIZER_WRITE_HTTP_PORT=3002
FEEDS_ORGANIZER_READ_HTTP_PORT=3003
FEEDS_ORGANIZER_WRITE_HTTP_PORT=3004

# Core Services - gRPC
BOOKMARKS_GRPC_PORT=50051
FEEDS_GRPC_PORT=50052

# BFF Services
USERS_BFF_PORT=3010
MANAGERS_BFF_PORT=3011

# ===========================================
# gRPC Service Endpoints (for BFF -> Core)
# ===========================================
BOOKMARKS_GRPC_HOST=localhost
FEEDS_GRPC_HOST=localhost
