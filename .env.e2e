# ===========================================
# Bokka E2E Test Environment Variables
# ===========================================

# Database (MySQL in Docker)
DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_NAME=bokka_test
DATABASE_USER=root
DATABASE_PASSWORD=root

# Valkey (Redis compatible)
VALKEY_HOST=valkey
VALKEY_PORT=6379

# Apache Pulsar
PULSAR_SERVICE_URL=pulsar://pulsar:6650
PULSAR_ADMIN_URL=http://pulsar:8080

# ===========================================
# Service Ports (internal Docker network)
# ===========================================

# Core Services - HTTP
BOOKMARKS_ORGANIZER_READ_HTTP_PORT=3000
BOOKMARKS_ORGANIZER_WRITE_HTTP_PORT=3000
FEEDS_ORGANIZER_READ_HTTP_PORT=3000
FEEDS_ORGANIZER_WRITE_HTTP_PORT=3000

# Core Services - gRPC
BOOKMARKS_GRPC_PORT=50051
FEEDS_GRPC_PORT=50051

# BFF Services
USERS_BFF_PORT=3000
MANAGERS_BFF_PORT=3000

# ===========================================
# gRPC Service Endpoints (Docker service names)
# ===========================================
BOOKMARKS_GRPC_HOST=bookmarks-organizer-read
FEEDS_GRPC_HOST=feeds-organizer-read
